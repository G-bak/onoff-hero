{
  "name": "onoff-hero",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run prepare:assets",
    "dev": "vinext dev",
    "check": "npm run lint && tsc --noEmit && npm run test:loading && npm run test:render && npm run test:fonts && npm run test:ui-state && npm run test:recovery && npm run test:sections",
    "ci:build": "npm run check && npm run build",
    "prepare:assets": "node scripts/prepare-team-assets.mjs",
    "prebuild": "npm run prepare:assets",
    "build": "vinext build && node scripts/check-production-css.mjs && node scripts/check-production-assets.mjs",
    "deploy": "npm run ci:build && wrangler deploy --config dist/server/wrangler.json",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint --deny-warnings",
    "test:loading": "node --experimental-strip-types --test tests/scene-loading.test.mjs",
    "test:render": "node --experimental-strip-types --test tests/scene-frame-loop.test.mjs",
    "test:fonts": "node --experimental-strip-types --test tests/scene-fonts.test.mjs",
    "test:ui-state": "node --experimental-strip-types --test tests/ui-state.test.mjs",
    "test:recovery": "node --experimental-strip-types --test tests/scene-recovery.test.mjs",
    "test:sections": "node --experimental-strip-types --test tests/section-entry.test.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "pretendard": "1.3.9",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@cloudflare/workers-types": "5.20260908.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "opentype.js": "^2.0.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "$sharp"
    }
  },
  "type": "module"
}
